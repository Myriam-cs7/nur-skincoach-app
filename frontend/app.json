{
  "expo": {
    "name": "Nur Protocol Skincoach",
    "slug": "nur-protocol-skincoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurprotocol",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture votre visage pour le diagnostic IA",
        "NSPhotoLibraryUsageDescription": "Sélectionner une photo pour le diagnostic"
      },
      "bundleIdentifier": "com.emergent.nurprotocolskin.zl0vs4",
      "associatedDomains": [
        "applinks:nurprotocol.com",
        "applinks:www.nurprotocol.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090C"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.emergent.nurprotocolskin.zl0vs4",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "nurprotocol.com", "pathPrefix": "/app" },
            { "scheme": "https", "host": "www.nurprotocol.com", "pathPrefix": "/app" },
            { "scheme": "https", "host": "nurprotocol.com", "pathPrefix": "/activate" },
            { "scheme": "https", "host": "www.nurprotocol.com", "pathPrefix": "/activate" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090C"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Capture votre visage pour le diagnostic IA"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A961"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
